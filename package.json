{
  "name": "sentinel-lint-action",
  "version": "1.0.0",
  "description": "GitHub Action that scans a repository with the published sentinel-lint npm package and produces SARIF 2.1.0, JSON or plain text reports with zero runtime dependencies.",
  "license": "MIT",
  "private": true,
  "type": "commonjs",
  "files": [
    "src",
    "action.yml",
    "README.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test test/",
    "test:fuzz": "node --test test/fuzz.test.js"
  },
  "keywords": [
    "github-actions",
    "security",
    "appsec",
    "static-analysis",
    "sarif",
    "nodejs",
    "devsecops",
    "sentinel-lint"
  ],
  "dependencies": {},
  "devDependencies": {
    "fast-check": "4.10.3"
  }
}
